# Perfil de teste do tomni-ui-openvpn. Chaves só de teste.
client
dev tun
proto udp
remote vpn.exemplo.test 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA256
verb 3
ca ca.crt
cert cliente-rsa.crt
key cliente-rsa.key
tls-crypt tc.key
